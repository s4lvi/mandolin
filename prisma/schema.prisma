generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  name            String?
  bio             String?          @db.Text
  hasSeenWelcome  Boolean          @default(false)
  lastSeenVersion String?          // Track which app version user has seen
  reviewPrefs     Json?            // Persisted review session defaults (see ReviewPrefs in validations/preferences.ts)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  decks           Deck[]
  sessions        Session[]
  accounts        Account[]
  stats           UserStats?
  achievements    UserAchievement[]
  reviewHistory   ReviewHistory[]
  feedback        Feedback[]
  lessonProgress       LessonProgress[]
  stories              Story[]
  courseEnrollments     CourseEnrollment[]
  courseLessonProgress CourseLessonProgress[]
  publishedLessons     PublishedLesson[]
  createdCourses       Course[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Deck {
  id          String   @id @default(cuid())
  name        String   @default("My Deck")
  description String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards       Card[]
  lessons     Lesson[]

  @@index([userId])
}

model Lesson {
  id          String           @id @default(cuid())
  number      Int
  title       String?
  date        DateTime?
  notes       String?          @db.Text
  sourceType  LessonSourceType @default(USER_CREATED)
  pagesStale  Boolean          @default(false) // Cards changed since interactive pages were generated
  pagesGenerating Boolean      @default(false) // Background generation of remaining pages in progress
  deckId      String
  createdAt   DateTime         @default(now())

  deck                 Deck                  @relation(fields: [deckId], references: [id], onDelete: Cascade)
  cards                CardLesson[]
  pages                LessonPage[]
  progress             LessonProgress[]
  publishedLesson      PublishedLesson?
  courseLessonProgress CourseLessonProgress[]

  @@unique([deckId, number])
  @@index([deckId])
}

model Card {
  id             String    @id @default(cuid())
  hanzi          String
  pinyin         String
  english        String
  notes          String?   @db.Text
  type           CardType  @default(VOCABULARY)
  isPriority     Boolean   @default(false)
  deckId         String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Spaced repetition fields
  correctCount   Int       @default(0)
  incorrectCount Int       @default(0)
  lastReviewed   DateTime?
  nextReview     DateTime?

  // SM-2 algorithm fields
  easeFactor     Float     @default(2.5)
  interval       Int       @default(0)
  repetitions    Int       @default(0)
  state          CardState @default(NEW)

  deck           Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
  lessons        CardLesson[]
  tags           CardTag[]
  reviewHistory  ReviewHistory[]
  testQuestions  TestQuestion[]

  @@unique([deckId, hanzi])
  @@index([deckId])
  @@index([deckId, nextReview, state]) // For fetching due cards efficiently
  @@index([deckId, state]) // For filtering by card state
  @@index([deckId, type]) // For filtering by card type
  @@index([deckId, isPriority]) // For filtering by priority
  @@index([nextReview])
  @@index([state])
}

// Many-to-many membership between cards and lessons.
model CardLesson {
  cardId    String
  lessonId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([cardId, lessonId])
  @@index([lessonId])
  @@index([cardId])
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  category  String?

  cards     CardTag[]
}

model CardTag {
  cardId    String
  tagId     String

  card      Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([cardId, tagId])
}

enum CardType {
  VOCABULARY
  GRAMMAR
  PHRASE
  IDIOM
}

enum CardState {
  NEW
  LEARNING
  REVIEW
  LEARNED
}

model UserStats {
  id              String   @id @default(cuid())
  userId          String   @unique
  totalXp         Int      @default(0)
  level           Int      @default(1)
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  lastReviewDate  DateTime?
  totalReviews    Int      @default(0)
  totalCorrect    Int      @default(0)
  dailyGoal       Int      @default(20)
  dailyProgress   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String
  icon        String
  xpReward    Int      @default(0)
  requirement Int      @default(1)
  category    String   @default("general")

  users       UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  progress      Int      @default(0)

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model ReviewHistory {
  id          String   @id @default(cuid())
  userId      String
  cardId      String
  quality     Int
  easeFactor  Float
  interval    Int
  xpEarned    Int      @default(0)
  reviewedAt  DateTime @default(now())
  source      String   @default("REVIEW") // REVIEW | LESSON | DRILL
  previousCard Json?   // Snapshot of SRS fields before this review, for undo

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([cardId])
  @@index([reviewedAt])
  @@index([userId, reviewedAt])
  @@index([cardId, reviewedAt])
}

model Feedback {
  id              String       @id @default(cuid())
  userId          String
  type            FeedbackType
  message         String       @db.Text
  email           String?
  testQuestionId  String?      // Optional: for reporting test question issues
  createdAt       DateTime     @default(now())

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  testQuestion    TestQuestion? @relation(fields: [testQuestionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([testQuestionId])
}

enum FeedbackType {
  BUG
  FEATURE
  GENERAL
}

model TestQuestion {
  id                String        @id @default(cuid())
  cardId            String
  direction         TestDirection

  // AI-generated content
  questionText      String        // "What does 你好 (nǐ hǎo) mean?"
  correctAnswer     String        // "hello"
  acceptableAnswers String[]      // ["hello", "hi", "greetings"]
  distractors       String[]      // 12-15 plausible wrong answers

  // Metadata
  generatedAt       DateTime      @default(now())
  timesUsed         Int           @default(0)

  card              Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  feedback          Feedback[]    // User-reported issues with this question

  @@unique([cardId, direction])
  @@index([cardId])
}

enum TestDirection {
  HANZI_TO_MEANING  // Show Chinese → answer meaning (English/Pinyin)
  MEANING_TO_HANZI  // Show English → answer Chinese (Hanzi)
  PINYIN_TO_HANZI   // Show Pinyin → answer Hanzi
}

model Changelog {
  id          String   @id @default(cuid())
  version     String   @unique // Semantic version (e.g., "1.0.0")
  title       String   // Short title for the release
  changes     String[] // Array of changelog items
  releaseDate DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([releaseDate])
}

// Interactive Lesson System Models
model LessonPage {
  id         String        @id @default(cuid())
  lessonId   String
  pageNumber Int           // 1, 2, 3, ..., 10+
  createdAt  DateTime      @default(now())

  lesson     Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  segments   PageSegment[]

  @@unique([lessonId, pageNumber])
  @@index([lessonId])
}

model PageSegment {
  id          String       @id @default(cuid())
  pageId      String
  orderIndex  Int          // 0, 1, 2, 3 (order within page)
  type        SegmentType
  content     Json         // Flexible structure for different segment types
  createdAt   DateTime     @default(now())

  page        LessonPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

enum SegmentType {
  TEXT              // Informational paragraph
  FLASHCARD         // Show/hide flashcard
  MULTIPLE_CHOICE   // Multiple choice question
  FILL_IN           // Fill in the blank
  TRANSLATION_EN_ZH // English → Chinese translation
  TRANSLATION_ZH_EN // Chinese → English translation
  FEEDBACK          // AI feedback (inserted dynamically)
}

model LessonProgress {
  id              String    @id @default(cuid())
  userId          String
  lessonId        String
  currentPage     Int       @default(1)
  totalPages      Int
  responses       Json[]    // Array of user responses per segment
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson          Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model Story {
  id             String   @id @default(cuid())
  userId         String
  title          String
  titlePinyin    String
  titleEnglish   String
  sentences      Json     // Array of {hanzi, pinyin, english, newWords?}
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  prefetched Boolean @default(false) // Generated ahead of time; surfaced on next "New Story"
}

// ─── Curriculum System ───

enum LessonSourceType {
  USER_CREATED
  COURSE
  COMMUNITY
}

enum CourseLessonStatus {
  LOCKED
  UNLOCKED
  IN_PROGRESS
  COMPLETED
}

model Course {
  id           String             @id @default(cuid())
  slug         String             @unique
  title        String
  description  String?            @db.Text
  level        Int                @default(1)
  imageUrl     String?
  isBuiltIn    Boolean            @default(true)
  isPublished  Boolean            @default(false) // user courses are private until the creator publishes
  userId       String?            // null for built-in/official courses
  totalLessons Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  lessons      CourseLesson[]
  enrollments  CourseEnrollment[]
  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isBuiltIn])
  @@index([isPublished])
  @@index([level])
  @@index([userId])
}

model CourseLesson {
  id          String               @id @default(cuid())
  courseId    String
  order       Int
  title       String
  description String?              @db.Text
  notes       String?              @db.Text
  createdAt   DateTime             @default(now())

  course      Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  cards       CourseLessonCard[]
  progress    CourseLessonProgress[]

  @@unique([courseId, order])
  @@index([courseId])
}

model CourseLessonCard {
  id              String       @id @default(cuid())
  courseLessonId  String
  hanzi           String
  pinyin          String
  english         String
  notes           String?      @db.Text
  type            CardType     @default(VOCABULARY)
  order           Int
  tags            String[]

  courseLesson    CourseLesson @relation(fields: [courseLessonId], references: [id], onDelete: Cascade)

  @@index([courseLessonId])
}

model CourseEnrollment {
  id                  String    @id @default(cuid())
  userId              String
  courseId             String
  currentLessonOrder  Int       @default(1)
  completedAt         DateTime?
  enrolledAt          DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course              Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model CourseLessonProgress {
  id              String             @id @default(cuid())
  userId          String
  courseLessonId  String
  lessonId        String?
  status          CourseLessonStatus @default(LOCKED)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseLesson    CourseLesson        @relation(fields: [courseLessonId], references: [id], onDelete: Cascade)
  lesson          Lesson?            @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@unique([userId, courseLessonId])
  @@index([userId])
  @@index([courseLessonId])
}

// ─── Community Publishing ───

model PublishedLesson {
  id          String    @id @default(cuid())
  lessonId    String    @unique
  userId      String
  title       String
  description String?   @db.Text
  cardCount   Int       @default(0)
  level       String?
  tags        String[]
  addCount    Int       @default(0)
  isApproved  Boolean   @default(true)
  publishedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([publishedAt])
  @@index([addCount])
  @@index([level])
}

// Shared, deploy-safe cache for character decompositions (pure function of the character)
model CharacterDecomposition {
  hanzi     String   @id
  data      Json
  createdAt DateTime @default(now())
}
